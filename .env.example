# FORJA — variáveis de ambiente do BACKEND (Netlify Functions).
#
# Copie este arquivo para `.env` (somente fora do Git; `.env*` está no
# .gitignore) para desenvolvimento local com `netlify dev`, ou cadastre as
# variáveis no painel do provedor de hospedagem para o deploy.
#
# NUNCA copie uma chave real para dentro deste arquivo versionado, nem para
# qualquer arquivo de `assets/js/` (JavaScript público).

# Obrigatória para a busca de vídeos no modal "Procurar vídeo".
# Restrinja a chave no Google Cloud à YouTube Data API v3 (e, se possível,
# por referência HTTP) antes de usá-la aqui.
YOUTUBE_API_KEY=

# Opcionais — o proxy já tem padrões seguros.
# YOUTUBE_DAILY_QUOTA_UNITS=3000
# YOUTUBE_CACHE_TTL_SECONDS=600
# YOUTUBE_MAX_RESULTS=10
# YOUTUBE_MAX_DURATION_SECONDS=60
# YOUTUBE_RELEVANCE_LANGUAGE=pt
# YOUTUBE_REGION_CODE=
# YOUTUBE_OEMBED_CHECK=1
# FORJA_ALLOWED_ORIGINS=https://1rayke1.github.io

# Já usada pelo gerador de planos por IA (docs/planejamento-inteligente.md).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Administração persistente do catálogo central (youtube-videos).
# FORJA_ADMIN_CREDENTIAL=
# YOUTUBE_DAILY_SEARCH_LIMIT=80
